# BDPayHub Environment Configuration
# Configure environment variables via the Secrets panel in AI Studio.
# Never commit production secrets or private credentials to version control.

# BDPAYHUB_API_BASE_URL: Rust + Axum REST API Base URL (configurable for dev, staging, production)
# Leave as default or override via Secrets panel in AI Studio.
# BDPAYHUB_API_BASE_URL=https://api.bdpayhub.com
# BDPAYHUB_SUPABASE_URL=https://auth.bdpayhub.com
# BDPAYHUB_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLIC_ANON_KEY
# BDPAYHUB_GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_OAUTH_WEB_CLIENT_ID
